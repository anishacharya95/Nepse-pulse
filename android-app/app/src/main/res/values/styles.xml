<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#16A34A</item>
        <item name="android:statusBarColor">@color/np_splash_background</item>
        <item name="android:navigationBarColor">@color/np_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme: exact NEPSE Pulse icon centred on dark navy. -->
    <style name="AppTheme.NoActionBarLaunch" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/np_splash</item>
        <item name="android:statusBarColor">@color/np_splash_background</item>
        <item name="android:navigationBarColor">@color/np_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
