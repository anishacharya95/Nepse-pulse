<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ system splash screen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/np_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/np_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/np_splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBackground">@color/np_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/np_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/np_splash_background</item>
        <item name="android:windowBackground">@drawable/np_splash</item>
    </style>
</resources>
