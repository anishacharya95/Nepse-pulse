<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/np_splash_background</item>
        <item name="android:navigationBarColor">@color/np_splash_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/np_splash_background</item>
        <item name="android:navigationBarColor">@color/np_splash_background</item>
    </style>

    <!--
        Launch theme shown from the first frame of the process. The system
        splash and the window background both use the exact NEPSE Pulse icon
        on dark navy, so older Android releases and Android 12+ match.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/np_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/np_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/np_splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/np_splash</item>
    </style>
</resources>
